# ---------------------------------------------------------------------------
# Models. At least one is required. Anthropic is the default builder.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# Optional: run the roles that execute against a brief on a cheaper model.
# Architect and reviewer stay on the strongest one - a bad plan or a missed
# defect costs far more than the tokens saved on it - while builders, which run
# many more turns, move down. Leave unset to run everything on one model.
HIVE_WORKER_MODEL=claude-sonnet-5

# A second vendor is what makes review independent rather than a model marking
# its own homework. Optional, but the run report will tell you when it is missing.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-pro-preview

# ---------------------------------------------------------------------------
# Services the swarm operates. Each is optional; a missing one is reported as
# unavailable and the operator agent routes around it rather than pretending.
# ---------------------------------------------------------------------------
GITHUB_TOKEN=
GITHUB_REPO=owner/repo

NEON_API_KEY=
NEON_PROJECT_ID=

RAILWAY_TOKEN=
RAILWAY_PROJECT_ID=
RAILWAY_ENVIRONMENT_ID=

CLERK_SECRET_KEY=

RESEND_API_KEY=
RESEND_FROM=hive@yourdomain.com
NOTIFY_EMAIL=you@yourdomain.com

# ---------------------------------------------------------------------------
# Hive state. Without HIVE_DATABASE_URL a run keeps its state in memory and is
# lost if the process dies. Point it at a Neon branch for durable runs.
# ---------------------------------------------------------------------------
HIVE_DATABASE_URL=
HIVE_WORKSPACE=.hive/workspace
HIVE_STATE_DIR=.hive

# ---------------------------------------------------------------------------
# Guardrails. These are the only thing standing between an unattended swarm and
# an unbounded bill, so they are enforced in code, not in a prompt.
# ---------------------------------------------------------------------------
HIVE_MAX_USD=25
HIVE_MAX_AGENT_USD=8
HIVE_MAX_TURNS=40
HIVE_MAX_PARALLEL=3
HIVE_MAX_REVIEW_ROUNDS=3
# Ceiling on the whole work graph - the architect's plan plus anything an
# integrator adds mid-run with add_task.
HIVE_MAX_TASKS=30
HIVE_WALL_CLOCK_MINUTES=90
HIVE_LOG_LEVEL=info

# Capabilities this run may exercise. Anything absent here is refused at the
# tool layer no matter what an agent decides. The four withheld by default -
# db:destructive, deploy:production, email:send, auth:admin - are the ones that
# can do something you cannot undo by re-running the build.
HIVE_GRANTS=fs:read,fs:write,shell:exec,net:read,bus:send,board:write,task:manage,github:read,github:write,db:read,db:write,deploy:preview
