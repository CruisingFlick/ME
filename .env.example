# ---- Database (Neon) -------------------------------------------------------
# Neon dashboard -> your project -> Connection string -> "Pooled connection".
# Any standard Postgres URL also works (local dev, CI); the app picks the
# right driver automatically based on the host.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.ap-southeast-2.aws.neon.tech/neondb?sslmode=require"

# ---- Sessions --------------------------------------------------------------
# Signs the rep and customer session cookies. Any random 32+ char string.
# Generate one with:  openssl rand -base64 32
# Changing this logs everybody out.
SESSION_SECRET="replace-me-with-a-long-random-string"

# ---- Photo uploads (Vercel Blob) ------------------------------------------
# Vercel dashboard -> Storage -> Blob -> create a store, then connect it to the
# project. Vercel injects this automatically on deploy; only needed by hand for
# local development. Photo upload is the only feature that needs it — the rest
# of the app runs fine without it.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxx"
